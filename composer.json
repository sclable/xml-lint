{
    "name": "sclable/xml-lint",
    "description": "A php cli tool to lint and validate xml files.",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Rutz",
            "email": "michael.rutz@sclable.com"
        },
        {
            "name": "Hakan Özkan",
            "email": "hakan.ozkan@sclable.com"
        }
    ],
    "keywords": [
        "xml",
        "lint",
        "cli",
        "xsd",
        "xml schema"
    ],
    "homepage": "https://github.com/sclable/xml-lint",
    "support": {
        "issues": "https://github.com/sclable/xml-lint/issues",
        "source": "https://github.com/sclable/xml-lint"
    },
    "bin": [
        "bin/xmllint"
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/finder": "^7.4 || ^8.1"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "sclable\\xmlLint\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "sclable\\xmlLint\\tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "test:unit": "phpunit",
        "test:functional": "behat --no-interaction",
        "cs": "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix"
    }
}
